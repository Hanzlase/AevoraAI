# Application Settings
APP_NAME=Aevora AI
ENVIRONMENT=development
VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./aevora.db

# Google Gemini API (Configurable model, required in later phases)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta / WhatsApp Cloud API (Required in later phases)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
