# Application Settings
APP_NAME=Aevora AI
ENVIRONMENT=development
VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./aevora.db

# Google Gemini API & Receptionist Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_CONTEXT_CHUNKS=5
AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0.2

# Meta / WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_API_TIMEOUT_SECONDS=20
WHATSAPP_MAX_RETRIES=2
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=1048576
WHATSAPP_EVENT_WORKER_ENABLED=true
WHATSAPP_EVENT_POLL_INTERVAL_SECONDS=1.0
WHATSAPP_MAX_EVENT_ATTEMPTS=5

# Voice Input & Faster-Whisper Settings
VOICE_INPUT_ENABLED=true
VOICE_MAX_FILE_SIZE_MB=16
VOICE_MAX_DURATION_SECONDS=180
VOICE_TEMP_DIR=temp_audio
FFMPEG_BINARY=ffmpeg
VOICE_PROCESSING_TIMEOUT_SECONDS=120
VOICE_MAX_CONCURRENT_JOBS=1
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_DOWNLOAD_ROOT=
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1

# Optional Spoken Voice Replies (TTS - disabled by default for privacy & control)
VOICE_REPLY_ENABLED=false
VOICE_REPLY_PROVIDER=edge_tts
VOICE_REPLY_LANGUAGE_MODE=match_user
VOICE_REPLY_TIMEOUT_SECONDS=30
